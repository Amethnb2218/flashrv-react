# ============================================
# FlashRV Backend - Environment Variables
# ============================================
# Copy this file to .env and fill with real values

# Server
PORT=4000
NODE_ENV=development
CSP_REPORT_ONLY=true

# Database
DATABASE_URL="postgresql://user:pass@host:5432/flashrv?schema=public"

# JWT - IMPORTANT: use a strong secret in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=change_me_to_a_strong_random_string
# Optional dedicated CSRF secret (recommended in production)
# CSRF_SECRET=change_me_to_another_strong_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
# Use lowercase: none | lax | strict
COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.jolofera.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
# Optional: multiple client IDs (web, iOS, Android), comma-separated
# GOOGLE_CLIENT_IDS=web_client_id,ios_client_id,android_client_id

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Root folder for uploads: jolofera/gallery, jolofera/products, etc.
CLOUDINARY_FOLDER_ROOT=jolofera

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
FRONTEND_ADMIN_PATH=/backoffice
# Public frontend base URL (used for payment return URLs)
BASE_URL=http://localhost:3000
# Backend public URL (used for payment callbacks/IPN)
API_URL=http://localhost:4000
# For production, set comma-separated allowed origins:
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional CSP connect sources (comma-separated):
# CSP_CONNECT_SRC=https://api.jolofera.com,https://your-cdn.com

# PayDunya
PAYDUNYA_MASTER_KEY=your_master_key
PAYDUNYA_PUBLIC_KEY=your_public_key
PAYDUNYA_PRIVATE_KEY=your_private_key
PAYDUNYA_TOKEN=your_token
PAYDUNYA_MODE=test
PAYDUNYA_REQUEST_TIMEOUT_MS=12000
PAYDUNYA_STORE_NAME=Jolof’Era
PAYDUNYA_STORE_TAGLINE=Paiement securise des reservations
PAYDUNYA_STORE_PHONE=
PAYDUNYA_STORE_ADDRESS=

# Wave
WAVE_API_KEY=your_wave_api_key
WAVE_API_URL=https://api.wave.com/v1

# OpenAI Assistant (optional)
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Web Push (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_MAILTO=mailto:contact@jolofera.com

